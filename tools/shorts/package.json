{
  "name": "bhoogol-shorts",
  "private": true,
  "type": "module",
  "description": "Makes Bhoogol quiz Shorts/Reels from the repo's own data. No AI needed to run: node make.mjs",
  "scripts": {
    "make": "node make.mjs",
    "week": "node make.mjs --start tomorrow --count 7 --stories",
    "test-frames": "node make.mjs --start tomorrow --count 3 --still 2,6,10"
  },
  "dependencies": {
    "@fontsource/baloo-2": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.5",
    "@fontsource/kalam": "^5.2.5",
    "@fontsource/mukta": "^5.2.5",
    "d3-geo": "^3.1.1",
    "flag-icons": "^7.2.3",
    "playwright": "1.56.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  }
}
